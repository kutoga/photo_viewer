{
  "name": "photo-map",
  "version": "2.0.0",
  "description": "A beautiful, private atlas for your photos and videos",
  "author": "Photo Map contributors",
  "license": "MIT",
  "main": "main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node start.js",
    "postinstall": "node scripts/copy-vendor.js",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "check": "node scripts/check.cjs",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:linux": "electron-builder --linux AppImage deb --x64",
    "benchmark": "node scripts/benchmark.cjs",
    "format": "prettier --write main.js preload.js start.js \"lib/*.cjs\" \"renderer/*.{js,css,html}\" \"scripts/*.{js,cjs}\" \"tests/*.{cjs,js}\" \"*.{json,md,cjs}\" .github/workflows/build.yml"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "ffmpeg-static": "5.3.0",
    "heic-decode": "2.1.0",
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "sharp": "0.35.4",
    "supercluster": "9.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "prettier": "3.9.8"
  },
  "build": {
    "appId": "org.photomap.desktop",
    "productName": "Photo Map",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "assets/icon.png",
      "maintainer": "Photo Map contributors",
      "syncDesktopName": true
    },
    "deb": {
      "compression": "gz"
    }
  },
  "desktopName": "org.photomap.desktop",
  "homepage": "https://github.com/kutoga/photo_viewer"
}
